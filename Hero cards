<!doctype html><html lang="ru"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Loody — Hover cards</title><style>body{margin:0;background:#070419}#loody-hover{max-width:1100px;margin:50px auto}button{cursor:pointer}</style><div id="loody-hover" class="viz-dotted-background">
<section class="loody-stage" aria-label="Worlds worth playing — hover prototype">
  <header><div><span class="eyebrow">OUR GAMES</span><h2>WORLDS WORTH <em>PLAYING</em></h2><p>A growing portfolio of high-quality mobile games with unique worlds, mechanics and characters.</p></div></header>
  <div class="games" aria-label="Игры"></div>
</section>
</div>
<style>
#loody-hover {padding:12px 0;}
#loody-hover .loody-stage {background:linear-gradient(125deg,#070419,#10062c);color:#fff;padding:44px 28px 42px;font-family:Arial,sans-serif;}
#loody-hover header {margin-bottom:50px;}
#loody-hover .eyebrow {color:#ab70ff;font-size:10px;letter-spacing:2px;font-weight:700;}
#loody-hover h2 {font-size:clamp(20px,3.5vw,29px);font-weight:900;line-height:1.1;letter-spacing:-.7px;margin:10px 0 8px;}
#loody-hover em {font-style:normal;color:#a46aff;}
#loody-hover p {font-size:11px;line-height:1.5;color:#d4cfe3;margin:0;max-width:580px;}
#loody-hover .games {display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px;isolation:isolate;overflow:visible;}
#loody-hover .game {position:relative;min-width:0;padding:0;border:0;background:transparent;aspect-ratio:168/222;z-index:0;transition:z-index 0s 280ms;}
#loody-hover .art {display:block;width:100%;height:100%;transform:translateY(0) scale(1) skewX(-3deg);transform-origin:50% 85%;filter:drop-shadow(0 2px 4px #783ce550);transition:transform var(--duration,280ms) cubic-bezier(.22,1,.36,1),filter var(--duration,280ms) ease;pointer-events:none;}
#loody-hover .game:is(:focus-visible,[aria-pressed="true"]) {z-index:10;transition-delay:0s;}
#loody-hover .game:is(:focus-visible,[aria-pressed="true"]) .art {transform:translateY(calc(-1 * var(--lift,16px))) scale(var(--scale,1.12)) skewX(-3deg);filter:drop-shadow(0 14px 12px #0009) drop-shadow(0 0 8px #985bff55);}
@media(hover:hover) {#loody-hover .game:hover {z-index:10;transition-delay:0s;}#loody-hover .game:hover .art {transform:translateY(calc(-1 * var(--lift,16px))) scale(var(--scale,1.12)) skewX(-3deg);filter:drop-shadow(0 14px 12px #0009) drop-shadow(0 0 8px #985bff55);}}
@media(max-width:520px) {#loody-hover .games {grid-template-columns:repeat(3,minmax(0,1fr));gap:28px 18px;}#loody-hover .loody-stage {padding:32px 24px;}#loody-hover header {margin-bottom:36px;}}
@media(prefers-reduced-motion:reduce) {#loody-hover .art {transition:none!important;}#loody-hover .game .art {transform:skewX(-3deg)!important;}}

#loody-hover .game {transition:transform var(--duration,280ms) cubic-bezier(.22,1,.36,1),z-index 0s 280ms;}
#loody-hover .game.is-active {z-index:10;transition-delay:0s;}
#loody-hover .game.neighbor-left {transform:translateX(-9px);}
#loody-hover .game.neighbor-right {transform:translateX(9px);}
#loody-hover .game.is-active .art {transform:translateY(calc(-1 * var(--lift,16px))) scale(var(--scale,1.12)) skewX(-3deg);filter:drop-shadow(0 16px 14px #000a) drop-shadow(0 0 3px #c68aff66) drop-shadow(0 0 8px #a04dff55);}
@media(prefers-reduced-motion:reduce) {#loody-hover .game {transform:none!important;transition:none!important;}}
</style>
<script>
(() => {
 const root=document.getElementById('loody-hover');
 const names=['Daily Scandal','Ice Bite','Big Ice Fish','Indiana Mouse','Olympus Upgrade','Toxic Treats'];
 const assets=["data:image/png;base64,", "data:image/png;base64,", "data:image/png;base64,", "data:image/png;base64,", "data:image/png;base64,", "data:image/png;base64,"];
 names.forEach((name,i)=>{
  const button=document.createElement('button');button.type='button';button.className='game cursor-interaction';button.setAttribute('aria-label',name);button.setAttribute('aria-pressed','false');
  const img=document.createElement('img');img.className='art';img.src=assets[i];img.alt=name;button.append(img);
  button.addEventListener('click',()=>{const was=button.getAttribute('aria-pressed')==='true';root.querySelectorAll('.game').forEach(b=>b.setAttribute('aria-pressed','false'));button.setAttribute('aria-pressed',String(!was));});
  button.addEventListener('pointerenter',()=>root.querySelectorAll('.game').forEach(b=>b.setAttribute('aria-pressed','false')));
  button.addEventListener('keydown',e=>{if(e.key==='Escape')button.setAttribute('aria-pressed','false');});
  root.querySelector('.games').append(button);
 });

 const buttons=[...root.querySelectorAll('.game')];
 let hovered=-1, focused=-1;
 function updateNeighbors(){
  const selected=buttons.findIndex(b=>b.getAttribute('aria-pressed')==='true');
  const active=hovered>=0?hovered:focused>=0?focused:selected;
  buttons.forEach((b,i)=>{
   b.classList.toggle('is-active',i===active);
   const sameRow=active>=0 && b.offsetTop===buttons[active].offsetTop;
   b.classList.toggle('neighbor-left',sameRow&&i===active-1);
   b.classList.toggle('neighbor-right',sameRow&&i===active+1);
  });
 }
 buttons.forEach((b,i)=>{
  b.addEventListener('pointerenter',e=>{if(e.pointerType!=='touch'){hovered=i;updateNeighbors();}});
  b.addEventListener('pointerleave',()=>{hovered=-1;updateNeighbors();});
  b.addEventListener('focus',()=>{focused=b.matches(':focus-visible')?i:-1;updateNeighbors();});
  b.addEventListener('blur',()=>{focused=-1;updateNeighbors();});
  b.addEventListener('click',updateNeighbors);
  b.addEventListener('keydown',e=>{if(e.key==='Escape'){focused=-1;updateNeighbors();}});
 });
 new ResizeObserver(updateNeighbors).observe(root);
 const state={scale:1.12,lift:16,duration:280};
 function render(){root.style.setProperty('--scale',state.scale);root.style.setProperty('--lift',state.lift+'px');root.style.setProperty('--duration',state.duration+'ms');}
 render();
 if(globalThis.Tweak){const tweak=new Tweak({container:root,onChange:render});tweak.addSlider(state,'scale',{label:'Увеличение',min:1.04,max:1.2,step:.01});tweak.addSlider(state,'lift',{label:'Подъём',min:4,max:28,unit:'px'});tweak.addSlider(state,'duration',{label:'Длительность',min:150,max:500,step:10,unit:'ms'});}
})();
</script>
</html>
